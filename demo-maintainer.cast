[0.016, "o", "\r\n=== 0. Build and start agentregistry ===\r\n\r\n# Clean up any previous run (including database volume).\r\n"]
[0.000, "o", "\u001b[33m$ docker compose -p agentregistry -f internal/daemon/docker-compose.yml down -v 2>/dev/null || true\u001b[0m\r\n"]
[1.193, "o", "\r\n"]
[0.000, "o", "# Build the server Docker image from source and start everything.\r\n# make run compiles the CLI (./bin/arctl), builds the server image,\r\n# and starts PostgreSQL + the registry via Docker Compose.\r\n"]
[0.000, "o", "\u001b[33m$ make run\u001b[0m\r\n"]
[0.773, "o", "Building running local Docker registry...\r\n"]
[0.000, "o", "if docker inspect docker-registry >/dev/null 2>&1; then \\\r\n\t\techo \"Registry already running. Skipping build.\" ; \\\r\n\telse \\\r\n\t\t docker run \\\r\n\t\t-d --restart=always -p \"5001:5000\" --name docker-registry \"docker.io/library/registry:2\" ; \\\r\n\tfi\r\n"]
[0.026, "o", "Registry already running. Skipping build.\r\n"]
[0.032, "o", "Building server Docker image (local)...\r\n"]
[0.000, "o", "docker build -f docker/server.Dockerfile -t localhost:5001/agentregistry-dev/agentregistry/server:v0.1.26-4-gcbbfcfd --build-arg LDFLAGS=\"-s -w -X 'github.com/agentregistry-dev/agentregistry/internal/version.Version=v0.1.26-4-gcbbfcfd' -X 'github.com/agentregistry-dev/agentregistry/internal/version.GitCommit=cbbfcfd' -X 'github.com/agentregistry-dev/agentregistry/internal/version.BuildDate=2026-02-26' -X 'github.com/agentregistry-dev/agentregistry/internal/version.DockerRegistry=localhost:5001'\" .\r\n"]
